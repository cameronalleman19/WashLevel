rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Fetch the calling user's Firestore profile
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Fetch the ownerId stored on a location document
    function locationOwnerId(locId) {
      return get(/databases/$(database)/documents/locations/$(locId)).data.ownerId;
    }

    // True if the caller owns the given location (by its ownerId value)
    function isOwner(ownerId) {
      return request.auth.uid == ownerId;
    }

    // True if the caller is a team member assigned to this location
    function isAllowedTeamMember(locId, ownerId) {
      let p = callerProfile();
      return p.isTeamMember == true
        && p.ownerId == ownerId
        && p.allowedLocations != null
        && locId in p.allowedLocations;
    }

    // Combined: owner or allowed team member for a location
    function hasLocationAccess(locId) {
      let ownerId = locationOwnerId(locId);
      return isOwner(ownerId) || isAllowedTeamMember(locId, ownerId);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own profile, owner reading team member, or manager with canViewTeam reading same-owner profiles
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || resource.data.ownerId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == resource.data.ownerId);

      // User can write their own profile, or owner can update team member profiles
      allow write: if request.auth != null
        && (request.auth.uid == userId
            || resource.data.ownerId == request.auth.uid);

      // Private subcollections: integrations, prefs
      match /{sub=**} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
        // Team members can read their owner's integrations and prefs
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == userId;
      }

      // Notifications: owner manages their own; any authenticated user can create (for cross-user task/alert notifications)
      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }
    }

    // ── Locations ────────────────────────────────────────────────────────────
    match /locations/{locId} {
      // Create: the new location's ownerId must match the creator's uid
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // Read: owner or an allowed team member
      allow read: if request.auth != null
        && (isOwner(resource.data.ownerId)
            || isAllowedTeamMember(locId, resource.data.ownerId));

      // Update/delete: owner only
      allow update, delete: if request.auth != null
        && isOwner(resource.data.ownerId);

      // Subcollections: tasks, equipment, inventory, shellyReadings, sensorReadings, daySummaries, etc.
      match /{sub=**} {
        allow read, write: if request.auth != null && hasLocationAccess(locId);
      }
    }

    // ── Sensors (flat top-level collection, keyed by locId) ──────────────────
    match /sensors/{locId} {
      allow read: if request.auth != null && hasLocationAccess(locId);
      // Write restricted to owner — only the owner's browser polls SensorPush and writes here
      allow write: if request.auth != null && isOwner(locationOwnerId(locId));
    }

    // ── Time Clock (top-level, doc ID = uid_date) ─────────────────────────────
    match /timeclock/{entryId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // resource == null handles the case where today's doc doesn't exist yet
      allow read: if request.auth != null;

      allow update, delete: if request.auth != null
        && resource != null
        && (resource.data.uid == request.auth.uid
            || (resource.data.ownerId != null && resource.data.ownerId == request.auth.uid));
    }

    // ── Invites ───────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      // Owner creates and manages their own invites
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Invited user can read and accept their own invite (matched by auth email)
      allow read, update: if request.auth != null
        && resource.data.email == request.auth.token.email;
    }

  // ── Subscriptions ────────────────────────────────────────────────────────
    match /subscriptions/{ownerId} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }

    // ── WashBoard: bays ──────────────────────────────────────────────────────
    // Owner has full access; the paired device has telemetry-only access.
    // Create/delete remain owner-only.
    // Kiosk identity is the anonymous uid stored as deviceUid at pairing.
    match /bays/{bayId} {
      // The kiosk signs in anonymously and claims its bay at pairing by writing
      // its uid to deviceUid. After that it may write telemetry only — never
      // pricing, functions, or anything else the operator controls. The bay is
      // strictly a display for dashboard config.

      // A bay with no deviceUid is unclaimed and can be paired. Bay ids are random,
      // and the window closes the moment a device claims it.
      function wbUnclaimed() {
        return !("deviceUid" in resource.data) || resource.data.deviceUid == null;
      }
      function wbIsDevice() {
        return request.auth != null
          && "deviceUid" in resource.data
          && resource.data.deviceUid == request.auth.uid;
      }
      function wbTelemetryOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastHeartbeat", "thermalState", "powerState", "batteryLevel",
          "heartbeatInterval", "relayConnected", "status", "currentFunction",
          "currentSessionStartedAt", "streamUrl", "lastSession", "healthUpdatedAt",
          "remoteCommand", "deviceId", "deviceUid", "deviceName"
        ]);
      }

      allow read: if request.auth != null
        && (isOwner(resource.data.ownerId) || wbIsDevice() || wbUnclaimed());

      allow update: if request.auth != null
        && (isOwner(resource.data.ownerId)
            || ((wbIsDevice() || wbUnclaimed()) && wbTelemetryOnly()));

      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── WashBoard: sessions ──────────────────────────────────────────────────
    // Read: authenticated owner. Create/update: open for iPad kiosk.
    match /sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create, update: if true;
    }

    // ── WashBoard: issues ────────────────────────────────────────────────────
    match /issues/{issueId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create, update: if true;
    }

    // ── WashBoard: transferCodes ─────────────────────────────────────────────
    match /transferCodes/{codeId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── WashBoard: pairingCodes ──────────────────────────────────────────────
    match /pairingCodes/{codeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if true;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── WashBoard: washboardLocations ────────────────────────────────────────
    // WashBoard account-wide settings (daily summary). Owner only - revenue data.
    match /washboardSettings/{ownerId} {
      allow read, write: if request.auth != null && request.auth.uid == ownerId;
    }

    match /washboardLocations/{locId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── WashBoard: washboardStaff ─────────────────────────────────────────────
    match /washboardStaff/{staffId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

        // ── WashBoard: promoCodes ─────────────────────────────────────────────
    match /promoCodes/{codeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if true;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── WashBoard: washboardPrepaidCodes ─────────────────────────────────────
    // Stored-value codes. Only Cloud Functions write them (Admin SDK).
    match /washboardPrepaidCodes/{code} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
      match /redemptions/{sessionId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/washboardPrepaidCodes/$(code)).data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    // ── WashBoard: washboardEvents ───────────────────────────────────────────
    // Device fault log. Written only by Cloud Functions, which use the Admin
    // SDK and bypass rules entirely, so no client ever needs write access.
    match /washboardEvents/{eventId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // ── WashBoard: kioskDevices ──────────────────────────────────────────────
    match /kioskDevices/{deviceId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
    }

  }
}
