{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/sidecar/pricing",
        "function": {
          "functionId": "sidecarPricing",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/sidecar/checkout",
        "function": {
          "functionId": "createSidecarCheckout",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/sidecar/validate",
        "function": {
          "functionId": "validateSidecarLicense",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/sidecar/license",
        "function": {
          "functionId": "sidecarLicenseBySession",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/sidecar/portal",
        "function": {
          "functionId": "createSidecarPortalSession",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}