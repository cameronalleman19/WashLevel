{
  "manifest_version": 3,
  "name": "WashLevel Sidecar",
  "version": "1.5.1",
  "description": "Aggregated Dencar sales, pass, and VIA analytics with projections",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://admin.dencar.sancsoft.net/*",
    "https://washlevel.com/*",
    "https://www.mycryptopay.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://archive-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open WashLevel Sidecar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.dencar.sancsoft.net/*",
        "https://www.mycryptopay.com/*"
      ],
      "js": [
        "proxy.js"
      ],
      "run_at": "document_idle"
    }
  ]
}